{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdzip.org/schema/manifest-1.2.0.schema.json",
  "title": "MDZip Manifest (1.2.0)",
  "$comment": "Validates manifests written by a conforming 1.2.0 producer, which MUST include spec.version and entryPoint (Section 14.1). Consumers MUST NOT reject an archive because its manifest lacks them or is absent (Sections 6, 14.2); validate older manifests against the schema for their spec.version. Unknown fields are allowed and must be preserved (Section 6.3). The prose specification is normative.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "spec": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "$comment": "Semantic Versioning 2.0.0 (the regular expression published at semver.org)."
        }
      },
      "required": [
        "version"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "application": {
          "$ref": "#/$defs/partyWithVersion"
        },
        "core": {
          "$ref": "#/$defs/partyWithVersion"
        }
      }
    },
    "author": {
      "$ref": "#/$defs/person"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "document",
        "project"
      ],
      "$comment": "Interpretation mode. Values are case-sensitive and must be lowercase. If absent, consumers treat the archive as document mode. See spec Section 5.7."
    },
    "entryPoint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\./)?(?!/)(?!.*//)(?!(?:.*/)?\\.{1,2}(?:/|$))[^\\\\:*?\"<>|\\u0000-\\u001F\\u007F]*\\.(?:[mM][dD]|[mM][aA][rR][kK][dD][oO][wW][nN])$",
      "$comment": "Spec Section 5.5 'Valid entry point path': a relative archive path (Section 5.4) to a .md or .markdown file (extension ASCII case-insensitive), with an optional single leading './'. A value failing this pattern is ERR_ENTRYPOINT_INVALID. Whether the file exists (ERR_ENTRYPOINT_MISSING) can't be checked by a schema. Matching against entries is case-sensitive after NFC normalization (Section 5.4.1)."
    },
    "language": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "created": {
      "$ref": "#/$defs/timestampOrActorTimestamp"
    },
    "modified": {
      "$ref": "#/$defs/timestampOrActorTimestamp"
    },
    "license": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cover": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\./)?(?!/)(?!.*//)(?!(?:.*/)?\\.{1,2}(?:/|$))[^\\\\:*?\"<>|\\u0000-\\u001F\\u007F]*[^/\\\\:*?\"<>|\\u0000-\\u001F\\u007F]$",
      "$comment": "Spec Section 6.2: a relative archive path (Section 5.4) naming a file, with an optional single leading './'. Unlike entryPoint, any file type. An invalid or missing cover is ignored by consumers (Section 6.4)."
    }
  },
  "$defs": {
    "urlString": {
      "type": "string",
      "format": "uri"
    },
    "partyWithVersion": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/urlString"
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "url": {
          "$ref": "#/$defs/urlString"
        }
      }
    },
    "actorTimestampObject": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "when"
      ],
      "properties": {
        "when": {
          "type": "string",
          "format": "date-time"
        },
        "by": {
          "$ref": "#/$defs/person"
        }
      }
    },
    "timestampOrActorTimestamp": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "$ref": "#/$defs/actorTimestampObject"
        }
      ]
    }
  },
  "required": [
    "spec",
    "entryPoint"
  ]
}
